-- Database: bd_laboratorio_orm
CREATE DATABASE bd_laboratorio_orm;

-- Creacion del schema
CREATE SCHEMA catalogos;

--- Creacion de tabla tipo equipo
CREATE TABLE catalogos.tipo_equipo(
id_tipo BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
nombre VARCHAR(100) NOT NULL UNIQUE,
descripcion VARCHAR(250)
);

-- Creación de tabla equipo
CREATE TABLE catalogos.equipo
(
id_equipo BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
codigo VARCHAR(20) NOT NULL UNIQUE,
nombre VARCHAR(150) NOT NULL,
marca VARCHAR(100),
estado VARCHAR(30) NOT NULL,
cantidad INTEGER NOT NULL,
id_tipo BIGINT NOT NULL,

CONSTRAINT chk_cantidad CHECK (cantidad >= 0),
CONSTRAINT chk_estado CHECK (
estado IN ('Disponible', 'En mantenimiento', 'Fuera de servicio')),
CONSTRAINT fk_tipo_equipo FOREIGN KEY (id_tipo)
REFERENCES catalogos.tipo_equipo(id_tipo)
);

