--- Relacion entre las tablas
SELECT e.codigo, e.nombre, e.marca, e.estado, e.cantidad,
       t.nombre AS tipo_equipo
FROM catalogos.equipo e INNER JOIN catalogos.tipo_equipo t
ON e.id_tipo = t.id_tipo ORDER BY e.id_equipo;


