<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="650.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.equiposlaboratorio.controller.EquipoController">
    <children>
        <GridPane layoutX="68.0" layoutY="71.0" prefHeight="180.0" prefWidth="420.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="110.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="310.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <Label text="Código" />
                <Label text="Nombre" GridPane.rowIndex="1" />
                <Label text="Marca" GridPane.rowIndex="2" />
                <Label text="Cantidad" GridPane.rowIndex="3" />
                <Label text="Tipo de equipo" GridPane.rowIndex="4" />
                <Label text="Estado" GridPane.rowIndex="5" />

                <TextField fx:id="txtCodigo" promptText="Código del equipo" GridPane.columnIndex="1" />
                <TextField fx:id="txtNombre" promptText="Nombre del equipo" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <TextField fx:id="txtMarca" promptText="Marca del equipo" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <TextField fx:id="txtCantidad" promptText="Cantidad de equipos" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                <ComboBox fx:id="cmbTipoEquipo" prefWidth="310.0" promptText="Seleccione el tipo" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                <ComboBox fx:id="cmbEstado" prefWidth="310.0" promptText="Seleccione el estado" GridPane.columnIndex="1" GridPane.rowIndex="5" />
            </children>
        </GridPane>

        <Label layoutX="39.0" layoutY="14.0" text="Registro de equipos de laboratorio">
            <font>
                <Font name="System Bold" size="17.0" />
            </font>
        </Label>

        <Separator layoutX="17.0" layoutY="48.0" prefHeight="2.0" prefWidth="860.0" />

        <Button fx:id="btnGuardar" layoutX="90.0" layoutY="268.0" mnemonicParsing="false" onAction="#guardarEquipo" prefWidth="125.0" text="Guardar Equipo" />
        <Button fx:id="btnCargar" layoutX="225.0" layoutY="268.0" mnemonicParsing="false" onAction="#cargarEquipos" prefWidth="125.0" text="Cargar Equipos" />
        <Button fx:id="btnModificar" layoutX="360.0" layoutY="268.0" mnemonicParsing="false" onAction="#modificarEquipo" prefWidth="125.0" text="Modificar Equipo" />
        <Button fx:id="btnLimpiar" layoutX="495.0" layoutY="268.0" mnemonicParsing="false" onAction="#limpiarFormulario" prefWidth="125.0" text="Limpiar" />
        <Button fx:id="btnEliminar" layoutX="630.0" layoutY="268.0" mnemonicParsing="false" onAction="#eliminarEquipo" prefWidth="125.0" text="Eliminar Equipo" />

        <Label layoutX="39.0" layoutY="325.0" text="Búsqueda de equipos">
            <font>
                <Font name="System Bold" size="15.0" />
            </font>
        </Label>

        <Label layoutX="40.0" layoutY="365.0" text="Nombre:" />
        <TextField fx:id="txtBuscarNombre" layoutX="105.0" layoutY="360.0" prefWidth="200.0" promptText="Buscar por nombre" />

        <Label layoutX="330.0" layoutY="365.0" text="Tipo:" />
        <ComboBox fx:id="cmbFiltroTipo" layoutX="375.0" layoutY="360.0" prefWidth="190.0" promptText="Todos los tipos" />

        <Button fx:id="btnBuscar" layoutX="585.0" layoutY="360.0" mnemonicParsing="false" onAction="#buscarEquipos" prefWidth="100.0" text="Buscar" />
        <Button fx:id="btnMostrarTodos" layoutX="700.0" layoutY="360.0" mnemonicParsing="false" onAction="#cargarEquipos" prefWidth="130.0" text="Mostrar todos" />

        <TableView fx:id="tblEquipos" layoutX="34.0" layoutY="410.0" prefHeight="210.0" prefWidth="840.0">
            <columns>
                <TableColumn fx:id="colCodigo" prefWidth="100.0" text="Código" />
                <TableColumn fx:id="colNombre" prefWidth="170.0" text="Nombre" />
                <TableColumn fx:id="colMarca" prefWidth="130.0" text="Marca" />
                <TableColumn fx:id="colEstado" prefWidth="150.0" text="Estado" />
                <TableColumn fx:id="colCantidad" prefWidth="100.0" text="Cantidad" />
                <TableColumn fx:id="colTipo" prefWidth="185.0" text="Tipo de equipo" />
            </columns>
        </TableView>
    </children>
</AnchorPane>
